PORT=8000
# NODE_ENV, ENV, ENVIRONMENT 중 하나가 production 이면 이 기본값으로 서버가 기동되지 않습니다.
INTERNAL_SECRET=fishrank_ai_internal_secret
# YOLO 가중치는 개발에서 첫 /analyze 요청 때 올립니다. 운영(NODE_ENV=production)은 기동 시 예열합니다.
# 개발에서 미리 올리려면 AI_WARMUP=true. 운영에서 끄려면 AI_WARMUP=false.
# AI_WARMUP=false
# 개발 기본 스레드는 1입니다. 운영은 PyTorch 기본값을 유지합니다. 바꾸려면 숫자를 지정하세요.
# TORCH_NUM_THREADS=1
UPLOADS_DIR=../apps/api/uploads
SPECIES_CONFIDENCE_S_THRESHOLD=0.7
SPECIES_CLASSIFIER=auto
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_DEVICE=cpu
CLIP_MIN_SCORE=0.08
YOLO_MODEL_PATH=models/fish_classifier/weights/best.pt
YOLO_MIN_CONFIDENCE=0.35
YOLO_IMGSZ=224
