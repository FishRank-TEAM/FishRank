{
  "name": "fishrank",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w web\" \"npm run dev -w api\"",
    "build": "npm run build -w web && npm run build -w api",
    "web": "npm run dev -w web",
    "api": "npm run dev -w api",
    "mobile": "npm run dev -w mobile",
    "db:up": "docker compose up -d postgres redis",
    "db:seed": "npm run seed -w api",
    "import:fish-species": "npm run import:fish-species -w api",
    "sync:fish-info": "npm run sync:fish-info -w api"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
