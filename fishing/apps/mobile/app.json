{
  "expo": {
    "name": "FishRank",
    "slug": "fishrank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fishrank",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#003d6b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fishrank.app",
      "infoPlist": {
        "NSCameraUsageDescription": "줄자 인증 낚시 기록 촬영에 카메라가 필요합니다.",
        "NSPhotoLibraryUsageDescription": "커뮤니티 글에 사진을 첨부할 때 갤러리 접근이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "낚시 날씨 조회를 위해 현재 위치가 필요합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#003d6b"
      },
      "package": "com.fishrank.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "줄자 인증 낚시 기록 촬영에 카메라가 필요합니다."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "낚시 날씨 조회를 위해 현재 위치가 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1"
    }
  }
}
