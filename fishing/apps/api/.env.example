# cp apps/api/.env.example apps/api/.env
# docker compose 기본값 (호스트 포트 5433)

DATABASE_URL=postgresql://fishrank:fishrank_local@localhost:5433/fishrank
JWT_SECRET=change-me-to-at-least-16-chars
JWT_ACCESS_EXPIRES=1h
REDIS_URL=redis://localhost:6379

PORT=4000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

AI_SERVER_URL=http://localhost:8000
# ai/.env 의 INTERNAL_SECRET 과 같아야 합니다.
AI_SERVER_SECRET=fishrank_ai_internal_secret

# 운영에서만 AI 테스터를 열 때 true. 개발(NODE_ENV != production)은 기본으로 열려 있습니다.
# AI_TESTER_ENABLED=false

# 선택. 없으면 날씨·공공데이터·지오코딩만 비어 있습니다.
# DATA_GO_KR_SERVICE_KEY=
# KMA_SERVICE_KEY=
# KAKAO_REST_API_KEY=
# MOF_MARINE_SPECIES_URL=
# MOF_FISHERY_PROTECT_WFS_URL=
# KHOA_FISHING_INDEX_URL=
# KHOA_TIDE_FCST_URL=
# RESERVOIR_CODE_URL=
# RESERVOIR_WATER_LEVEL_URL=
# NIFS_API_KEY=
# NIFS_API_URL=
# MBRIS_MARINE_SPECIES_URL=
# NAKDONG_FRESHWATER_URL=
